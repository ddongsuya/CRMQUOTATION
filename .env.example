# 이 파일을 복사해 .env 로 만들고 실제 값을 채우세요. (.env 는 git 에 올라가지 않음)

# ─────────────────────────────────────────────────────────
# 데이터베이스 — PostgreSQL (Neon)
# ─────────────────────────────────────────────────────────
# prisma/schema.prisma 의 datasource 가 provider = "postgresql" 이므로
# 반드시 postgresql:// 스킴이어야 합니다. SQLite(file:...) 는 동작하지 않습니다.
#
# Neon 콘솔 → 프로젝트 → Connection string 에서 복사.
# 형식: postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# ─────────────────────────────────────────────────────────
# NextAuth
# ─────────────────────────────────────────────────────────
# 운영 배포 전 반드시 새로 발급: openssl rand -base64 32
NEXTAUTH_SECRET="여기에-임의의-긴-문자열"

# 로컬 개발: http://localhost:3000
# 배포 시: 실제 서비스 도메인으로 교체
NEXTAUTH_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────
# 오류 모니터링 — Sentry (선택. 비워 두면 완전히 비활성)
# ─────────────────────────────────────────────────────────
# sentry.io → 프로젝트(Next.js) → Client Keys(DSN). Vercel 에는 Production·Preview 환경변수로 등록.
NEXT_PUBLIC_SENTRY_DSN=""
# (선택) 빌드 시 소스맵 업로드용. 없으면 업로드만 건너뜀.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# ─────────────────────────────────────────────────────────
# 로컬 개발 DB 분리 (docs/OPERATIONS.md §3)
# ─────────────────────────────────────────────────────────
# 로컬 .env 의 DATABASE_URL 은 Neon "dev" 브랜치를, Vercel 의 DATABASE_URL 은 main 브랜치를 가리켜야 한다.
# 스키마 변경: npm run db:migrate:new -- <이름>  →  npm run db:deploy  (prisma db push 사용 금지)

# ─────────────────────────────────────────────────────────
# 인증 (로그인 게이트)
# ─────────────────────────────────────────────────────────
# 계정 발급: npm run user:set-password -- <email> --role ADMIN   (비밀번호는 프롬프트로 입력)
# 로컬에서만 로그인 없이 데모 계정으로 쓰려면 1. Vercel production 에서는 값이 있어도 무시된다.
AUTH_DISABLED=""
# 자가 가입 허용(기본 닫힘). 열 때도 허용 도메인 메일만, role 은 MEMBER 고정.
REGISTRATION_OPEN=""
ALLOWED_EMAIL_DOMAINS="csco.co.kr"
